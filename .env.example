# Copy to .env, or set these in your terminal. Never commit real keys.

# LLM: "ollama" (local, slow on 4GB GPU) or "groq" (fast, free tier)
LLM_PROVIDER=groq
GROQ_API_KEY=

# LangSmith tracing (https://smith.langchain.com, free tier)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=production-rag
